---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const techStackBackend = [
  { name: "Node.js", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg" },
  { name: "Express", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/express/express-original.svg" },
  { name: "MongoDB", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg" },
  { name: "OpenAI", logo: "https://cdn.worldvectorlogo.com/logos/openai-2.svg" },
  { name: "Playwright", logo: "https://playwright.dev/img/playwright-logo.svg" },
  { name: "Socket.IO", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/socketio/socketio-original.svg" },
];

const techStackFrontend = [
  { name: "HTML5", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg" },
  { name: "CSS3", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg" },
  { name: "JavaScript", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" },
  { name: "Chart.js", logo: "https://www.chartjs.org/img/chartjs-logo.svg" },
];

const techStackInfra = [
  { name: "Linux", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg" },
  { name: "Nginx", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nginx/nginx-original.svg" },
  { name: "PM2", logo: "https://raw.githubusercontent.com/Unitech/pm2/master/pres/pm2-v4.png" },
];

const features = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="3"/><line x1="8" y1="10" x2="8" y2="18"/><line x1="8" y1="6" x2="8" y2="7"/><path d="M12 18v-5a2 2 0 0 1 4 0v5"/><line x1="12" y1="10" x2="12" y2="18"/></svg>`,
    title: "Import de Leads",
    description: "5 sources d'import : connexions LinkedIn, recherche par mots-clés, URL Sales Navigator, réactions de posts, ou import CSV."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.46V19l4 2v-8.54z"/></svg>`,
    title: "Tri & Qualification",
    description: "Filtrez automatiquement les profils sans photo, incomplets, inactifs, étudiants ou retraités avant de prospecter."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
    title: "Scan IA Spruce",
    description: "L'IA analyse chaque profil et l'assigne au bon persona avant toute demande de connexion. Personnalisation dès le début."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/></svg>`,
    title: "Prospection IA",
    description: "Connexions et messages personnalisés envoyés automatiquement depuis votre compte LinkedIn. Anti-détection avancée incluse."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: "Gestion des Réponses",
    description: "Toutes vos conversations centralisées. Classification positive, neutre, négative. Aucun lead ne se perd."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>`,
    title: "Closing & Analytics",
    description: "Pipeline de closing du premier RDV jusqu'à la signature. Dashboard ROI temps réel avec chaque étape de votre pipeline."
  },
];

const pipeline = [
  { step: "01", title: "Importez vos Leads", description: "5 sources LinkedIn et CSV" },
  { step: "02", title: "Triez et qualifiez", description: "Filtres avancés" },
  { step: "03", title: "Scan IA", description: "Persona automatique" },
  { step: "04", title: "Prospection IA", description: "Envoi automatique" },
  { step: "05", title: "Gestion des réponses", description: "Conversations centralisées" },
  { step: "06", title: "Setting", description: "Relances intelligentes" },
  { step: "07", title: "Closing", description: "Du RDV à la signature" },
  { step: "08", title: "Statistiques", description: "ROI en temps réel" },
];

const aiCapabilities = [
  "Analyse du profil LinkedIn avant contact",
  "Assignation automatique au bon persona",
  "Messages de connexion personnalisés",
  "Réponses contextuelles GPT-4",
  "Classification des réponses (positif/neutre/négatif)",
  "Relances intelligentes et timing optimal",
];

const antiDetection = [
  "User-Agent rotation automatique",
  "Délais aléatoires (200ms–5s)",
  "Mouvements de souris simulés",
  "Scroll progressif naturel",
  "Typage humain (vélocité variable)",
  "Stealth mode Playwright",
  "Mobile emulation parfaite",
];

const securityFeatures = [
  "JWT avec expiration",
  "Passwords hashés (bcrypt)",
  "Input sanitization",
  "Rate limiting",
  "CORS configuré",
  "SSL/TLS Let's Encrypt",
];

const differentiators = [
  "Pipeline complet en un seul outil — de l'import du lead à la signature client",
  "Scan IA qui analyse chaque profil avant de prospecter pour une personnalisation maximale",
  "Anti-détection avancée avec simulation du comportement humain sur LinkedIn",
  "Classification automatique des réponses (positif / neutre / négatif) par IA",
  "Dashboard ROI temps réel avec chaque étape du pipeline commerciale",
